# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
#
# These do NOT travel with the repo, by design. They are carried between machines
# through OneDrive instead — see scripts/sync-secrets.mjs (`npm run secrets`).
# The repo itself deliberately lives outside OneDrive: syncing .git and
# node_modules corrupted both (118 unreadable git objects, 2026-08-17).
.env
.env*.local

# Per-machine Claude Code permissions — local to one machine, never shared.
# This was previously caught only by a GLOBAL gitignore
# (~/.config/git/ignore), which does not exist on a fresh machine or a fresh
# clone: `git add -A` there would have committed it. Declared here so the
# protection travels with the repo rather than with one laptop.
.claude/settings.local.json

# The context-budget hook's cumulative counters. Per-session and per-machine: it
# records byte offsets into ONE transcript path, so another machine's copy is not
# merely useless, it is wrong — offsets from a file that does not exist there. The
# hook rewrites it on every prompt, so committing it would also put a churning
# binary-ish blob in every diff.
.claude/.context-budget.state.json

# Subagent artefacts. `.claude/hooks/agent-write-scope.js` confines every read-only
# agent's writes to this directory, so it fills up with grounding maps and review
# notes that are working material, not repo content. Ignored deliberately rather
# than by oversight: the post-run `git status --porcelain` check is only readable
# if an agent run leaves it empty.
#
# AT THE REPO ROOT, NOT UNDER `.claude/`, and that is a permissions fact rather than
# a filing preference — `.claude` is a protected path and a write under it is never
# auto-approved, so an unattended pipeline stalls per artefact. See the header of
# agent-write-scope.js. Do not tidy it back inside `.claude/`.
.handoff/

# Agent worktrees. `isolation: "worktree"` leaves a FULL SECOND COPY of the tree here
# if it is not removed, and every check that walks the repo then finds it — the sibling
# project got four phantom findings naming paths inside a leftover copy. Ignored here
# and excluded from the audit's walk, because either alone leaves the other reporting
# on a tree nobody is working in.
.claude/worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Scratch: review patches and verification copies. Never committed, never compiled.
_to_delete/
