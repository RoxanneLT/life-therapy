{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 300000,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "WebSearch",
      "WebFetch",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_code",
      "mcp__claude_ai_Vercel__list_deployments",
      "mcp__claude_ai_Vercel__list_projects",
      "mcp__claude_ai_Vercel__list_teams",
      "mcp__claude_ai_Vercel__get_deployment",
      "mcp__claude_ai_Vercel__get_deployment_build_logs",
      "mcp__claude_ai_Vercel__get_runtime_logs",
      "mcp__claude_ai_Vercel__get_runtime_errors"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(//**/.env*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npx prisma migrate*)",
      "Bash(npx prisma db push*)",
      "Bash(vercel*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(curl*)",
      "mcp__claude_ai_Vercel__deploy_to_vercel"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-gate.js\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ddl-gate.js\""
          }
        ]
      }
    ]
  }
}
