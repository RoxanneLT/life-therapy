{
  // Tier-0 dead-code detection. `npm run crawl:tier0`.
  //
  // Deliberately NOT part of `npm run check` — knip reports whole categories the
  // audit does not gate on, and wiring it into the build would make `check` fail
  // for reasons nobody has agreed to act on yet.
  //
  // JSONC, not JSON, because every ignore below needs its REASON. An ignore list
  // without reasons is a silencer; with them it is a decision log, and the next
  // person can tell a deliberate retention from an oversight. Same rule the audit's
  // allowlists follow.
  "$schema": "https://unpkg.com/knip@6/schema.json",

  "entry": [
    // Next.js resolves these by convention, never by import. Without them listed,
    // every page in the app reads as an unused file and the first run is 100%
    // noise — which is how a tool gets run once and never again.
    "app/**/{page,layout,loading,error,not-found,route,template,default,global-error}.{ts,tsx}",
    "app/**/sitemap.ts",
    "app/**/robots.ts",
    "scripts/**/*.mjs",
    "lib/**/*.test.ts"

    // REMOVED 2026-08-19, all reported by knip's own configuration hints as
    // matching nothing. An entry pattern with no matches is the same disease as a
    // stale allowlist entry: it reads as a considered decision and silently covers
    // whatever is written at that path next.
    //   middleware.ts        — no middleware file exists (nor src/middleware.ts)
    //   prisma/seed.ts       — the seed is scripts/seed.ts, already covered
    //   lib/**/*.test.tsx    — there are no .tsx tests
    //   next.config.mjs      — redundant, knip resolves it by convention
    //   eslint.config.mjs    — redundant, same
    //   postcss.config.mjs   — redundant, same
  ],

  "project": [
    "app/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "scripts/**/*.mjs"
  ],

  "ignore": [
    // shadcn/ui primitives. These arrive as a SET — you install the component and
    // its Radix dependency together — and several are staged ahead of the screens
    // that will use them. Reporting them as dead code every run trains people to
    // skim the whole report, which costs more than the few unused files.
    //
    // This is the one entry most likely to rot into cover for real dead code. The
    // trade is deliberate: components/ui/ is vendored, near-never hand-edited, and
    // its contents are traceable to `npx shadcn add`.
    "components/ui/**"
  ],

  "ignoreDependencies": [
    // Required AT RUNTIME by lib/generated/prisma, which re-exports its runtime —
    // but never imported by name from source, so knip cannot see the edge.
    // Uninstalling it breaks every query in the app.
    "@prisma/client",

    // Consumed by the Tailwind v4 PostCSS pipeline through config, not imports.
    "tailwindcss",
    // Resolved by postcss.config.mjs at build time; provided transitively by Next.
    "postcss-load-config",

    // Used only by components/ui/form.tsx, which is ignored above as part of the
    // shadcn set. Listed here so the dependency and the file it serves are
    // suppressed for the SAME stated reason rather than two unrelated ones.
    "react-hook-form",
    "@hookform/resolvers",
    "@radix-ui/react-collapsible",
    "@radix-ui/react-popover",
    "@radix-ui/react-tooltip"
  ],

  // REMOVED 2026-08-19, along with `lib/generated/**`, `@tailwindcss/postcss`,
  // `postcss`, `eslint-config-next` and `ignoreBinaries: ["prisma", "tsx"]` — every
  // one reported by knip's own configuration hints as suppressing nothing, and each
  // verified by REMOVAL rather than by reading: taken out, re-run, no new finding.
  // An ignore that suppresses nothing is a stale exemption, and this file's own
  // opening paragraph says an ignore without a live reason is a silencer.

  // DELIBERATELY NOT IGNORED — these are the signal this tool exists for.
  //
  // ACTED ON 2026-08-19. Everything the first run flagged as dead is now gone:
  //   · @eslint/eslintrc — uninstalled. eslint.config.mjs imports the
  //     eslint-config-next presets directly and never touched the compat helper.
  //   · lib/copy.ts — deleted. Zero imports, AND named in the audit's dual-domain
  //     exemption list, so an exemption was protecting a dead file. The exemption
  //     check now covers that list too, and the deletion is what proved it fires.
  //   · placeholder-tab.tsx, auto-refresh.tsx, settings-tabs.tsx (the admin one —
  //     the portal has a live file of the same name), date-picker-step.tsx,
  //     time-slot-step.tsx — all deleted, each verified at zero imports first.
  //
  // STILL OPEN, and left deliberately:
  //   · the five booking/order email builders in lib/email-templates.ts — no
  //     callers, and they interpolate client-supplied names UNESCAPED, so they are
  //     a loaded gun for whoever wires them up. Deleting them is the safer fix,
  //     but they are a template set someone may intend to use; the escaping is the
  //     real defect and it should be fixed whether or not they stay.
  //   · ~57 unused exports and ~31 unused types. Mostly zod-inferred `*Input`
  //     types that document a schema even where nothing imports them. Low value,
  //     high noise; not worth a sweep.
}
