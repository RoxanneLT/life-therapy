{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/{page,layout,loading,error,not-found,route,template,default,global-error}.{ts,tsx}",
    "app/**/sitemap.ts",
    "app/**/robots.ts",
    "middleware.ts",
    "next.config.mjs",
    "eslint.config.mjs",
    "postcss.config.mjs",
    "prisma/seed.ts",
    "scripts/**/*.mjs",
    "lib/**/*.test.ts",
    "lib/**/*.test.tsx"
  ],
  "project": ["app/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "scripts/**/*.mjs"],
  "ignore": [
    "lib/generated/**"
  ],
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "tailwindcss",
    "postcss",
    "eslint-config-next"
  ],
  "ignoreBinaries": ["prisma", "tsx"]
}
